<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!-- Protobuf-generated classes -->
    <Match>
        <Package name="~dev\.ikm\.tinkar\.service\.proto.*"/>
    </Match>

    <!-- Spring constructor injection: storing a Spring-managed singleton bean via constructor DI
         is standard practice. The bean reference is controlled by the container, not caller code. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Field name="tinkarService"/>
    </Match>

</FindBugsFilter>
